def cv_tahun(cols):
    skor = []
    for tr, va in folds:
        rf, xgb = latih(X_full.iloc[tr][cols], y_full.iloc[tr], "tanpa")
        p = proba_ens(rf, xgb, X_full.iloc[va][cols])
        skor.append(average_precision_score(y_full.iloc[va], p))
    return skor

